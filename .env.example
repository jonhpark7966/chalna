# Chalna
CHALNA_RESULTS_DIR=/home/jonhpark/workspace/chalna/results

# ElevenLabs Scribe v2
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
SCRIBE_MODEL_ID=scribe_v2
CHALNA_SCRIBE_CACHE_DIR=/home/jonhpark/workspace/chalna/results/scribe_cache
CHALNA_SCRIBE_TIMEOUT=600
CHALNA_SCRIBE_DELIVERY_MODE=webhook
ELEVENLABS_WEBHOOK_ID=
ELEVENLABS_WEBHOOK_SECRET=
CHALNA_SCRIBE_WEBHOOK_TIMEOUT=7200
CHALNA_SCRIBE_RECOVERY_TIMEOUT=90

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=chalna@0.1.0
SENTRY_TRACES_SAMPLE_RATE=0.05
